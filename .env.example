# Copy to .env.local and fill in real values. Never commit .env.local.

# Required — itinerary generation (OpenAI)
OPENAI_API_KEY=

# Optional — live tour search and prices (Viator Partner API).
# Without this, tour lookups are skipped.
VIATOR_API_KEY=
# VIATOR_API_BASE_URL=https://api.viator.com

# Production — cache and rate limiting (Upstash Redis).
# Locally the app falls back to an in-memory cache if these are unset.
# The KV_REST_API_URL / KV_REST_API_TOKEN names also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — override the default Go City / London Pass affiliate link
# NEXT_PUBLIC_GOCITY_AFFILIATE_LINK=

# Production only — shared secret with the Cloudflare Worker that fronts /planner.
# Leave unset locally, otherwise local requests are rejected with 403.
# PLANNER_PROXY_SECRET=
